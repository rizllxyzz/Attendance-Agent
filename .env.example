# =========================
# ZETARIS CONFIG (Data Layer)
# =========================
# REST API endpoint Zetaris
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# Org ID (usually 1 on local install)
ZETARIS_ORG_ID=1
# API Key from Zetaris web UI (create in user menu)
ZETARIS_API_KEY=
# Web UI URL (for smoke test)
ZETARIS_BASE_URL=http://localhost:3000

# =========================
# LLM CONFIG (Power Layer - Nightshift/Meterless)
# =========================
# Nightshift Runtime URL (from Console top-right)
MODEL_BASE_URL=http://127.0.0.1:8088/v1
# Nightshift Runtime API key (from Console)
MODEL_API_KEY=
# Model name (meterless/auto or specific Nemotron)
NEMOTRON_MODEL=meterless/auto

# =========================
# AGENT CONFIG
# =========================
# Server port for FastAPI (optional, default 8000)
AGENT_PORT=8000
