# Zetaris Data Virtualization
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift (primary AI provider, OpenAI-compatible)
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=your-meterless-runtime-token
NEMOTRON_MODEL=meterless/auto

# Aliases (optional)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-meterless-runtime-token
METERLESS_MODEL=meterless/auto

# Database (used by docker-compose full stack)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=presensi
DB_USER=root
DB_PASS=

# Sample mode: run without live Zetaris/Nightshift
SAMPLE_MODE=false

# WhatsApp Cloud API (opsional, untuk bot orang tua)
# WHATSAPP_PROVIDER=meta  # atau 'evolution'
# WHATSAPP_VERIFY_TOKEN=presensi-verify-token
# WHATSAPP_ACCESS_TOKEN=your-meta-access-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# EVOLUTION_URL=http://localhost:8081
# EVOLUTION_API_KEY=hackathon-key
# EVOLUTION_INSTANCE=presensi

# Server
HOST=0.0.0.0
PORT=8000