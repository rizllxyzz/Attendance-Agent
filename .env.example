# =============================================================
#  .env.example  -  CONTOH isi konfigurasi
#
#  Cara pakai:
#    1. Salin file ini, ganti nama jadi ".env"
#    2. Isi nilai aslinya (key dari sponsor/dashboard)
#    3. File ".env" JANGAN pernah di-commit ke GitHub
# =============================================================

# --- AI Provider (via Meterless Nightshift -> NVIDIA Nemotron) ----
# PENTING: NVIDIA API key TIDAK disimpan di project ini.
#   1. Buat NVIDIA API key di https://build.nvidia.com/models
#   2. Masukkan ke Nightshift desktop app -> Providers -> NVIDIA -> Save
#   3. Copy Runtime URL + token dari Nightshift Console
#   4. Isi di bawah ini (Nightshift yang route ke NVIDIA Nemotron)
MODEL_BASE_URL=http://localhost:8088/v1
MODEL_API_KEY=your-nightshift-runtime-token
NEMOTRON_MODEL=meterless/auto

# Alternatif: provider langsung (OpenAI/Gemini/Groq) - opsional
# GROQ_API_KEY=
# GEMINI_API_KEY=

# --- Sponsor hackathon ----------------------------------------
# Zetaris   - federasi data lintas sumber (API key dari Zetaris web UI)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift - server nyala hanya saat dibutuhkan
METERLESS_KEY=your-nightshift-runtime-token

# --- Server ---------------------------------------------------
PORT=8080
AGENT_SHARED_TOKEN=buat-token-agent-panjang

# --- Database -------------------------------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=presensi
DB_USER=root
DB_PASS=